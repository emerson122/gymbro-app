# Copia este archivo a .env.local para desarrollo local
# En producción, estas variables se configuran en Vercel > Settings > Environment Variables
# NUNCA subas .env.local ni pongas estos valores directo en el código

# Token del bot de Telegram (regenéralo en @BotFather antes de usarlo en producción,
# ya quedó expuesto una vez en un chat)
TELEGRAM_BOT_TOKEN="8563085292:AAGJNaqnlcPbUyQscp49z8nYBqv0voi5Ykc"

# Tu chat id de Telegram (lo obtienes escribiéndole /start a tu bot y viendo el log,
# o con https://api.telegram.org/bot<token>/getUpdates)
TELEGRAM_CHAT_ID="2120694641"

# Upstash Redis (gratis, sin tarjeta): https://console.upstash.com
# Si conectas la integración de Upstash desde el marketplace de Vercel,
# estas dos variables se crean solas.
UPSTASH_REDIS_REST_URL="https://emerging-coral-119357.upstash.io"
UPSTASH_REDIS_REST_TOKEN="gQAAAAAAAdI9AAIgcDE5NjI1MzU1YzBjMWY0NDQ0YjFiZmE5NGE1YjcxODhjYQ"

# Secreto para verificar que las llamadas a /api/cron/* vienen de Vercel Cron
CRON_SECRET=cambia-esto-por-algo-random

# Secreto en la URL del webhook de Telegram, para que nadie más pueda pegarle a tu endpoint
TELEGRAM_WEBHOOK_SECRET=cambia-esto-tambien
